# ============================================================
# Smart Box Delivery — Server (Render / local)
# Copier vers server/.env pour le dev local
# Production : deploy/render.env ou dashboard Render
# ============================================================

NODE_ENV=development

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Frontend (CORS — no trailing slash). Localhost is always allowed by the server.
# Dev local:
CLIENT_URL=http://localhost:5173
# Production on Render (official app — works on blocked-Vercel networks):
# CLIENT_URL=https://anti-tamper.onrender.com
# CLIENT_URLS=https://anti-tamper.vercel.app,http://localhost:5173

# Public API URL (promo videos, absolute links)
PUBLIC_BASE_URL=http://localhost:3001
# Production: PUBLIC_BASE_URL=https://anti-tamper.onrender.com
# Render also sets RENDER_EXTERNAL_URL automatically if PUBLIC_BASE_URL is omitted.

# MQTT (public broker — use broker.emqx.io; test.mosquitto.org is often blocked on ISP networks)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Email — Brevo REST API (required for OTP signup, password reset, security alerts)
# 1. Brevo → SMTP & API → API keys → create key (starts with xkeysib-)
# 2. Brevo → Senders → verify SMTP_FROM address
EMAIL_ENABLED=true
BREVO_API_KEY=your-brevo-api-key-xkeysib
SMTP_FROM=your-verified-email@gmail.com
SMTP_FROM_NAME=Smart Box Delivery
# Optional SMTP fallback only if API fails (default: API only)
# BREVO_ALLOW_SMTP_FALLBACK=false
DELIVERY_CURRENCY=RWF
MOMO_PAY_NUMBER=+250 791 691 817
MOMO_PAY_NAME=Smart Box Delivery
WHATSAPP_SUPPORT=250791691817
WHATSAPP_DISPLAY=+250 791 691 817

MAX_PROMO_VIDEO_MB=200

# Render injecte PORT automatiquement — ne pas le définir en production
